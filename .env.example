# The gateway base URL the browser calls. Must be reachable from the client device.
# Local dev: http://localhost:8080   ·   Production: https://api.your-domain
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: dev OTP code hint shown on the login screen (backend dev code is 000000).
NEXT_PUBLIC_DEV_OTP=000000
